<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="MNNApplicationWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Monday Night Net</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkButton">
                <property name="icon-name">document-open-symbolic</property>
                <property name="action-name">win.open-net</property>
                <property name="tooltip-text" translatable="yes">Open Net (Ctrl+O)</property>
              </object>
            </child>
            <child type="start">
              <object class="GtkButton">
                <property name="icon-name">document-save-symbolic</property>
                <property name="action-name">win.save-net</property>
                <property name="tooltip-text" translatable="yes">Save Net (Ctrl+S)</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwToastOverlay" id="toast-overlay">
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">5</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Date:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <child>
                          <object class="GtkEntry" id="date-entry">
                            <property name="placeholder-text">YYYY-MM-DD</property>
                            <property name="secondary-icon-name">pan-down-symbolic</property>
                            <property name="secondary-icon-activatable">True</property>
                            <property name="input-purpose">number</property>
                            <signal name="icon-press" handler="on_date_entry_icon_pressed"/>
                          </object>
                        </child>
                        <child>
                          <object class="GtkPopover" id="date-entry-popover">
                            <property name="has-arrow">True</property>
                            <property name="autohide">True</property>
                            <child>
                              <object class="GtkCalendar" id="date-entry-calendar">
                                <signal name="day-selected" handler="on_calendar_day_selected"/>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Frequency</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="frequency-entry">
                        <property name="placeholder-text">146.535</property>
                        <property name="input-purpose">number</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">SS Callsign</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="callsign-entry">
                        <property name="placeholder-text"></property>
                        <property name="input-hints">uppercase-chars</property>
                        <property name="buffer">
                          <object class="GtkEntryBuffer" id="callsign-entry-buffer"/>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">SS Name</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="name-entry">
                        <property name="input-purpose">name</property>
                        <property name="buffer">
                          <object class="GtkEntryBuffer" id="name-entry-buffer"/>
                        </property>
                      </object>
                    </child>
                  </object><!-- top row box -->
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkFlowBox" id="columns-flowbox">
                            <property name="orientation">horizontal</property>
                            <property name="hexpand">false</property>
                            <property name="vexpand">true</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">6</property>
                            <style>
                              <class name="footer-bar"/>
                            </style>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Total:</property>
                                <property name="xalign">0</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="grand-total-label">
                                <property name="label">0</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">true</property>
                                <style>
                                  <class name="numeric-total"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object><!-- columns and total -->
                    </child>
                    <child>
                      <object class="MNNStationMapView" id="map-view">
                        <property name="hexpand">true</property>
                        <property name="vexpand">true</property>
                        <property name="width-request">360</property>
                      </object>
                    </child>
                  </object><!-- columns and map -->
                </child>
                <child>
                  <object class="GtkFrame" id="city-totals-section">
                    <property name="label" translatable="yes">Totals</property>
                    <property name="visible">false</property>
                    <child>
                      <object class="GtkFlowBox" id="city-totals-flowbox">
                        <property name="selection-mode">none</property>
                        <property name="homogeneous">true</property>
                        <property name="column-spacing">12</property>
                        <property name="row-spacing">6</property>
                        <property name="max-children-per-line">10</property>
                        <property name="margin-start">6</property>
                        <property name="margin-end">6</property>
                        <property name="margin-top">6</property>
                        <property name="margin-bottom">6</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object><!-- root content box -->
            </child>
          </object><!-- toast overlay -->
        </property>
        <child type="bottom">
          <object class="GtkActionBar"/>
        </child>
      </object>
    </property>
  </template>
</interface>
