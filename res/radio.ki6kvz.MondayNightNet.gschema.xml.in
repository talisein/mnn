<?xml version="1.0" encoding="utf-8"?>

<schemalist>
  <schema id="@schema_id@" path="@schema_path@">
    <key name="width" type="i">
      <default>700</default>
    </key>
    <key name="height" type="i">
      <default>500</default>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
    </key>
    <key name="is-fullscreen" type="b">
      <default>false</default>
    </key>
    <key name="current-net" type="s">
      <default>"default-net.json"</default>
    </key>
    <key name="callsign" type="s">
      <default>""</default>
    </key>
    <key name="name" type="s">
      <default>""</default>
    </key>
  </schema>
</schemalist>
