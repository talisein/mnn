# Meson build directories
/build/
/build-*/
!/build-aux/

# flatpak-builder state and output repo
/.flatpak-builder/
/repo/

# Wrap-downloaded subproject sources (keep the .wrap files + packagefiles)
/subprojects/*/
!/subprojects/packagefiles/
/subprojects/packagecache/
/subprojects/.wraplock
# meson writes this redirect itself when gom's nested sqlite3mc.wrap is used;
# committed, it breaks a fresh checkout (it names a file gom has not got yet)
/subprojects/sqlite3mc.wrap

# clangd index
/.cache/

# Local agent / editor state
/.claude/
/prompts/

# Emacs lock files
.#*
