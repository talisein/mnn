<!--
    A per-user .msi around build-msvc\stage\. make-msi.ps1 passes
    -d Version=, -d StageDir= and -d IconFile=. No custom actions: nothing
    runs at install time, as an MSIX will require (README.md).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- The UpgradeCode never changes: it is how a new version finds the old
       one to replace. -->
  <Package Name="Monday Night Net"
           Manufacturer="KI6KVZ"
           Version="$(var.Version)"
           UpgradeCode="6F1742D9-2199-4EC3-A0BB-B6A775582728"
           Scope="perUser"
           Language="1033">

    <!-- Same-version upgrades too, so a rebuilt .msi replaces the installed
         one instead of installing beside it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Monday Night Net is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/talisein/mnn" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- %LOCALAPPDATA%\Programs, where per-user apps go. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Monday Night Net" />
      </Directory>
    </StandardDirectory>

    <!-- The whole stage, subdirectories and all. -->
    <ComponentGroup Id="StageFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.StageDir)\**" />
    </ComponentGroup>

    <!-- The AppUserModelID matches the one the app sets on itself when it is
         not packaged, so its taskbar button groups with this shortcut. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="1D81164F-2A8B-4BEF-8AD8-18521438AE1B">
        <Shortcut Id="AppShortcut"
                  Name="Monday Night Net"
                  Description="Amateur radio net monitoring"
                  Target="[INSTALLFOLDER]bin\monday-night-net.exe"
                  WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="radio.ki6kvz.MondayNightNet" />
        </Shortcut>
        <!-- A per-user shortcut needs an HKCU key path (ICE43). -->
        <RegistryValue Root="HKCU" Key="Software\KI6KVZ\Monday Night Net"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="StageFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
