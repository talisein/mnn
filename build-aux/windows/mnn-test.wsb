<!--
    Windows Sandbox: a clean Windows with nothing installed. build-msvc is
    mapped read-only at C:\mnn, so it holds the .msi and the stage, and
    running C:\mnn\stage\bin\monday-night-net.exe directly also checks that
    the app never writes next to itself. C:\logs is writable and syncs
    back to meiko. See README.md. Open with:

        start build-aux\windows\mnn-test.wsb
-->
<Configuration>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\dev\mnn\build-msvc</HostFolder>
      <SandboxFolder>C:\mnn</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <!-- Writable, for logs: the AsusMiku folder Syncthing shares with meiko. -->
    <MappedFolder>
      <HostFolder>C:\Users\agpot\Desktop\Meiko\logs</HostFolder>
      <SandboxFolder>C:\logs</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <Networking>Enable</Networking>
</Configuration>
